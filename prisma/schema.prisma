// Fase 1 — Núcleo de datos para `strategy` + `ai-core`.
// Solo incluye lo que BrainService necesita para reconstruir memoria histórica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Sector {
  ECOMMERCE
  SAAS
  HEALTH
  EDUCATION
  REAL_ESTATE
  HOSPITALITY
  FINANCE
  PROFESSIONAL_SERVICES
  OTHER
}

enum Role {
  ADMIN
  COLABORADOR
  CLIENTE
}

enum StrategyStatus {
  DRAFT
  GENERATING
  READY
  APPROVED
  ARCHIVED
  FAILED
}

enum OutcomeStatus {
  SUCCESS
  NEUTRAL
  FAILURE
}

model Client {
  id      String  @id @default(cuid())
  name    String
  sector  Sector
  website String?

  /// Brief del cliente. Es la entrada del BLOQUE 1 del prompt, así que vive
  /// en la fila del cliente: el orquestador se invoca solo con `clientId` y
  /// no depende de que el caller reenvíe el brief en cada generación.
  description      String   @db.Text
  targetAudience   String   @db.Text
  valueProposition String   @db.Text
  currentChannels  String[] @default([])
  monthlyBudgetEur Int
  goals            String[] @default([])
  constraints      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategies Strategy[]
  profiles   Profile[]

  @@index([sector])
}

/// Cuenta de acceso. Distinta de `Client`: `Client` es una empresa a la que la
/// agencia presta servicio; `Profile` es una persona que entra en la
/// aplicación. Un CLIENTE es la persona que consulta las estrategias de SU
/// empresa, de ahí el `clientId`.
model Profile {
  /// NO se autogenera: es el UUID de `auth.users` que asigna Supabase. Es el
  /// único puente entre el sistema de identidad y este modelo de datos.
  id String @id

  email    String  @unique
  fullName String?
  role     Role    @default(CLIENTE)

  /// Obligatorio si role = CLIENTE. La invariante no se puede expresar en
  /// Prisma; va como CHECK en SQL (ver prisma/constraints.sql).
  clientId String?

  isActive  Boolean  @default(true)

  /// Solo significa algo en un CLIENTE: marca al CONTACTO PRINCIPAL de la
  /// empresa. Le habilita dos cosas —dar de alta compañeros y registrar el
  /// resultado real de las estrategias—, ambas por el mismo motivo: es quien
  /// responde por la cuenta. Los miembros que él crea nacen con `false`.
  ///
  /// `@map` conserva el nombre original de la columna: el campo se renombró en
  /// Prisma cuando pasó a gobernar dos permisos y no solo la invitación, pero
  /// renombrar la columna habría sido mover datos sin ninguna necesidad.
  ///
  /// Es un booleano y no un rol nuevo a propósito: `puedeVerEstrategia`,
  /// `puedeGestionarTablero` y `puedeGenerarPara` usan `role !== "CLIENTE"`
  /// como sinónimo de "es del equipo", así que un rol intermedio atravesaría
  /// los tres y obtendría acceso de agencia sin que nada lo detectara.
  esContactoPrincipal Boolean @default(false) @map("puedeInvitar")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// SetNull y no Cascade: borrar una empresa cliente no debe borrar la
  /// cuenta de la persona, solo dejarla sin empresa asignada.
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tareasAsignadas StrategyTask[]
  notificaciones  Notification[]

  @@index([role])
  @@index([clientId])
}

model Strategy {
  id       String @id @default(cuid())
  clientId String

  sector Sector

  status  StrategyStatus @default(DRAFT)
  title   String
  content Json

  /// Solo se rellena cuando `status = FAILED`. Sin esto, una estrategia
  /// fallida es indistinguible de una colgada y no se puede diagnosticar
  /// sin cruzar logs.
  failureReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  outcome StrategyOutcome?
  tasks   StrategyTask[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([sector, status])
}

enum TareaEstado {
  POR_HACER
  EN_CURSO
  HECHA
}

/// De qué parte de la estrategia salió la tarea. Permite agrupar y explicarle
/// al cliente por qué está ahí, en vez de darle una lista de frases sueltas.
enum TareaOrigen {
  QUICK_WIN
  CANAL
  PILAR
  /// Creada a mano por el cliente, no derivada de la estrategia.
  MANUAL
}

/// Tarjeta del tablero de ejecución de una estrategia.
///
/// Vive en su propia tabla y no dentro de `Strategy.content` porque ese JSON
/// está validado contra StrategyOutputSchema: meterle el estado de cada tarea
/// rompería la validación al leer, que es la defensa de la vista de detalle.
model StrategyTask {
  id         String @id @default(cuid())
  strategyId String

  titulo  String
  detalle String? @db.Text

  estado TareaEstado @default(POR_HACER)
  origen TareaOrigen

  /// Posición dentro de su columna. Al mover, la tarea se encola al final.
  orden Int

  /// Responsable. Siempre un perfil de la MISMA empresa; lo comprueba la
  /// Server Action, porque el schema no puede expresar esa relación cruzada.
  asignadoAId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade: una tarea sin estrategia no significa nada. Una estrategia
  /// APPROVED no se puede borrar, así que un tablero en uso no desaparece.
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  /// SetNull: dar de baja a una persona no borra el trabajo que tenía
  /// asignado, solo lo deja sin responsable.
  asignadoA Profile? @relation(fields: [asignadoAId], references: [id], onDelete: SetNull)

  /// Cubre exactamente la consulta del tablero: las tareas de una estrategia,
  /// agrupadas por columna y ordenadas dentro de ella.
  @@index([strategyId, estado, orden])
  @@index([asignadoAId])
}

model StrategyOutcome {
  id         String @id @default(cuid())
  strategyId String @unique

  sector Sector

  status           OutcomeStatus
  performanceScore Float
  metrics          Json
  learnings        String        @db.Text
  measuredAt       DateTime

  /// Barrera antes de que este caso entre en la memoria que alimenta a la IA.
  ///
  /// `learnings` viaja al prompt que genera la estrategia de OTRA empresa del
  /// mismo sector. Desde que el cliente puede escribirlo, ese texto deja de
  /// estar bajo control de la agencia: sin esta barrera, cualquiera podría
  /// colocar instrucciones dirigidas al modelo en el contexto de un competidor.
  ///
  /// Lo pone en `true` cualquier escritura hecha por ADMIN o COLABORADOR —que
  /// el equipo lo escriba ES la revisión— y lo devuelve a `false` cualquier
  /// escritura hecha por el cliente, incluida una edición posterior. Sin ese
  /// reseteo la barrera sería decorativa: bastaría con pasar la revisión y
  /// luego cambiar el texto.
  revisado Boolean @default(false)

  /// Interruptor editorial: ¿queremos que este caso influya en lo que la IA
  /// genera para otros clientes?
  ///
  /// Distinto de `revisado`, y por eso son dos campos y no uno. `revisado`
  /// responde "¿ha mirado alguien del equipo este texto?" —es una barrera de
  /// seguridad—. Este responde "¿queremos que enseñe?" —es una decisión de
  /// criterio—. Un caso puede estar revisado y ser correcto, y aun así no
  /// convenir como referencia: un cliente atípico, un mercado que ya cambió, una
  /// táctica que dejó de ser legal.
  ///
  /// Por defecto `true`: el sistema aprende salvo que alguien decida lo
  /// contrario. Con el defecto invertido, la memoria volvería a quedarse vacía
  /// hasta que alguien fuera marcando casos uno a uno, que es exactamente el
  /// problema del que veníamos.
  ///
  /// NO afecta a lo que ve el cliente. Su panel depende solo del estado de la
  /// estrategia; apagar esto la retira del contexto de la IA y de nada más.
  usarEnMemoriaIA Boolean @default(true)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  /// Las cuatro igualdades —`sector`, `status`, `revisado` y `usarEnMemoriaIA`—
  /// van antes del rango sobre `performanceScore`: así siguen siendo prefijo del
  /// índice y Postgres resuelve filtro y orden con un solo index scan.
  @@index([sector, status, revisado, usarEnMemoriaIA, performanceScore(sort: Desc)])
  @@index([measuredAt(sort: Desc)])
}

enum TipoNotificacion {
  ESTRATEGIA_PUBLICADA
  ESTRATEGIA_GENERADA
  RESULTADO_REGISTRADO
}

/// Aviso dentro de la aplicación. Sin correo ni terceros.
///
/// UNA FILA POR DESTINATARIO. Cuando un aviso va a cinco personas se crean
/// cinco filas. La alternativa —una notificación con muchos lectores— obliga a
/// una tabla de unión solo para responder "¿cuántas me quedan sin leer?", que
/// es justo la consulta que se hace en cada render de la barra.
model Notification {
  id     String           @id @default(cuid())
  userId String
  tipo   TipoNotificacion

  titulo  String
  mensaje String @db.Text

  /// Ruta interna a la que lleva el aviso. Sin esto obliga a buscar a mano lo
  /// que anuncia, que es el problema que estas notificaciones vienen a evitar.
  enlace String?

  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cubre las dos consultas que existen: contar las no leídas de alguien
  /// —igualdades en prefijo— y listar las suyas por fecha.
  @@index([userId, leida, createdAt(sort: Desc)])
}
