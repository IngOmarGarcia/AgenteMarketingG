# Copia este fichero a `.env` y rellena los valores.
# `.env` está en .gitignore — nunca lo commitees.

# Postgres (Supabase). Usa el POOLER, no el host directo `db.<ref>.supabase.co`:
# ese solo resuelve a IPv6 y falla con P1001 en redes IPv4.
#
# Son DOS cadenas, mismo host, distinto puerto. No es opcional:
#
#   6543 (transaction mode) — la APLICACIÓN. Obligatorio en serverless
#        (Netlify/Vercel), donde cada invocación abre conexiones nuevas y una
#        conexión de sesión por invocación agota el límite enseguida.
#   5432 (session mode)     — el CLI de Prisma. A través del 6543, `db push`,
#        `db pull` y `studio` se CUELGAN hasta agotar el tiempo, sin error.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Proveedor de IA: "anthropic" (producción) u "ollama" (local, sin coste).
AI_PROVIDER="anthropic"

# Anthropic — Console -> API Keys.
# Obligatoria SOLO con AI_PROVIDER=anthropic; con ollama puede quedar vacía.
ANTHROPIC_API_KEY="sk-ant-..."

# Solo con AI_PROVIDER=ollama. Requiere `ollama serve` corriendo y el modelo
# descargado (`ollama pull qwen2.5`).
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:latest"

# URL pública del despliegue, SIN barra final. Ej: https://mi-sitio.netlify.app
#
# Es la que se usa para construir los enlaces que salen por correo (invitación,
# magic link, recuperación). Si se deja vacía se deduce de las cabeceras
# `x-forwarded-*`, que funciona en local y normalmente también detrás de un
# proxy — pero definirla explícitamente en producción elimina toda duda.
#
# OJO: además hay que darla de alta en Supabase, en
# Authentication -> URL Configuration:
#   Site URL      = https://mi-sitio.netlify.app
#   Redirect URLs = https://mi-sitio.netlify.app/**
# Si el `redirectTo` no está en esa lista, Supabase lo IGNORA y manda el correo
# apuntando a la Site URL, que en un proyecto nuevo es http://localhost:3000.
APP_URL=""

# Supabase Auth — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"

# Clave pública: respeta RLS, es segura en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clave de administración: SALTA RLS POR COMPLETO.
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
