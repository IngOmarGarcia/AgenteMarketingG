# Entorno para los tests unitarios (`npm test`).
#
# Valores ficticios a propósito: los tests usan dobles inyectados y nunca
# abren una conexión ni llaman a una API. Así la suite corre en CI y en
# cualquier máquina sin credenciales reales, y un test no puede tocar por
# accidente la base de datos de producción.
#
# Este fichero SÍ se commitea (no contiene secretos).
DATABASE_URL="postgresql://test:test@localhost:5432/test"
ANTHROPIC_API_KEY="sk-ant-test-noop"
NEXT_PUBLIC_SUPABASE_URL="https://test.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-test-noop"
SUPABASE_SERVICE_ROLE_KEY="service-role-test-noop"
NODE_ENV="test"
